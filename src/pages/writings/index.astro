---
import Container from "~/components/common/container.astro";
import Layout from "~/layouts/Layout.astro";
import { getCollection } from "astro:content";

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  content={{
    title: "writings | advtszn",
    description:
      "notes on things i'm learning and building, written up as i go",
  }}
>
  <main>
    <Container>
      <div class="space-y-4 lg:max-w-[45%] lg:pl-4">
        <h1 class="font-heading text-3xl font-medium md:text-5xl">writings</h1>
        <p class="text-muted-foreground font-medium text-lg">
          notes and devlogs on things that i learn and build
        </p>
        <ol class="space-y-2.5">
          {
            writings.map(({ id, data: { title } }) => (
              <li class="pl-1.5 text-lg font-light">
                <a
                  class="underline underline-offset-4"
                  href={`/writings/${id}`}
                >
                  {title}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </main>
</Layout>
