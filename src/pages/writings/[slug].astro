---
import Container from "~/components/common/container.astro";
import Layout from "~/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Link from "~/components/common/link.astro";
import { ArrowLeft } from "lucide-astro";

export async function getStaticPaths() {
  const writings = await getCollection(
    "writings",
    ({ data }) => data.status === "published",
  );

  return writings.map((writing) => ({
    params: { slug: writing.id },
    props: { writing },
  }));
}

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });

const { writing } = Astro.props;
const { Content } = await render(writing);
---

<Layout
  content={{
    title: `${writing.data.title} | advtszn`,
    description: writing.data.description,
  }}
>
  <main>
    <Container>
      <div class="space-y-6">
        <a
          href="/writings"
          class="text-muted-foreground flex items-center pt-2 text-sm"
          ><ArrowLeft size={16} class="mr-1.5" /> Back to writings</a
        >
        <div
          class="mb-12 flex flex-col gap-y-4 lg:flex-row lg:justify-between lg:items-center lg:gap-y-0"
        >
          <h1 class="font-heading text-3xl font-medium">
            {writing.data.title}
          </h1>
          <p
            class="text-muted-foreground text-sm font-medium whitespace-nowrap"
          >
            {formatDate(writing.data.date)}
          </p>
        </div>
        <article class="mdx mb-20 space-y-6">
          <Content />
        </article>
      </div>
    </Container>
  </main>
</Layout>
