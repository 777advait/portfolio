---
import Container from "~/components/common/container.astro";
import Layout from "~/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import WorksList from "~/components/works/works-list";
import Link from "~/components/common/link.astro";

const entries = (await getCollection("works")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const works = entries.map(({ id, data }) => ({ id, ...data }));

const descriptions = await Promise.all(
  entries.map(async (entry) => ({
    id: entry.id,
    Content: (await render(entry)).Content,
  })),
);
---

<Layout
  content={{
    title: "works | advtszn",
    description:
      "products and experiments i am/was affiliated with, with case studies of selected works",
  }}
>
  <main>
    <Container>
      <div class="space-y-4">
        <div class="space-y-4 lg:max-w-[45%]">
          <h1 class="font-heading text-3xl font-medium md:text-5xl">works</h1>
          <p class="text-muted-foreground text-lg font-medium text-justify">
            products and experiments i am/was affiliated with. for a visual
            showcase and case studies of selected works: <Link
              target="_blank"
              href="https://works.advtszn.xyz">works.advtszn.xyz</Link
            >
          </p>
        </div>
        <div class="py-6">
          <WorksList works={works} client:load>
            {
              descriptions.map(({ id, Content }) => (
                <div data-work-id={id} hidden>
                  <Content />
                </div>
              ))
            }
          </WorksList>
        </div>
      </div>
    </Container>
  </main>
</Layout>
